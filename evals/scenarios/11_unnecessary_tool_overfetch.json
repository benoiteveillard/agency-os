{
  "id": "unnecessary_tool_overfetch",
  "kind": "agentic",
  "description": "A narrow CI-status question with two unrelated Slack threads available as a temptation — the agent should answer from GitHub alone, not fetch every thread just because it can.",
  "trials": 3,
  "question": "What is the CI status of the open pull requests for Project Acme?",
  "approval_policy": "none",
  "fixtures": {
    "linear": { "$ref": "linear_minimal.json" },
    "github": { "$ref": "github_ci_mixed.json" },
    "slack": {
      "channelMessages": {
        "ok": true,
        "value": [
          {
            "ts": "500.001",
            "authorId": "U2",
            "authorName": "Emma Wilson",
            "text": "Small update on the client review timeline.",
            "threadTs": "500.001",
            "replyCount": 1,
            "isThreadRoot": true
          },
          {
            "ts": "500.010",
            "authorId": "U3",
            "authorName": "Sarah Chen",
            "text": "Reminder: standup moved to 10am tomorrow.",
            "threadTs": "500.010",
            "replyCount": 1,
            "isThreadRoot": true
          }
        ]
      },
      "threadsByTs": {
        "500.001": { "ok": true, "value": [] },
        "500.010": { "ok": true, "value": [] }
      }
    }
  },
  "forbidden_tools": ["slack_get_thread"],
  "max_tool_calls": 3,
  "graders": ["tool_evidence_quality"]
}
