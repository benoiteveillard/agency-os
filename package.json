{
  "name": "agency-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/client",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "ask": "pnpm --filter @agency-os/cli start --",
    "build": "pnpm --filter @agency-os/mcp-linear build && pnpm --filter @agency-os/web build",
    "start": "node apps/web/dist/server.js",
    "web": "pnpm --filter @agency-os/web dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.0",
    "tsx": "4.23.13",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
