{
  "name": "@agency-os/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx src/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -n server,client -c blue,magenta \"pnpm dev:server\" \"pnpm dev:client\"",
    "build:server": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=bundle --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/server.js",
    "build:client": "vite build",
    "build": "pnpm build:server && pnpm build:client",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@agency-os/agent": "workspace:*",
    "@agency-os/observability": "workspace:*",
    "@agency-os/observability-otel-export": "workspace:*",
    "@agency-os/runtime": "workspace:*",
    "@agency-os/shared": "workspace:*",
    "@hono/node-server": "2.1.1",
    "dotenv": "17.4.2",
    "hono": "4.13.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "vite": "8.3.0"
  }
}
