{
  "name": "@agency-os/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=bundle --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/server.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@agency-os/agent": "workspace:*",
    "@agency-os/runtime": "workspace:*",
    "@agency-os/shared": "workspace:*",
    "@agency-os/observability": "workspace:*",
    "@agency-os/observability-otel-export": "workspace:*",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.7",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
