# Anthropic API key used to run the agent.
ANTHROPIC_API_KEY=

# Linear: a personal API key scoped to Read only.
# Create one at https://linear.app/settings/api
LINEAR_API_KEY=

# GitHub: a fine-grained personal access token scoped to the
# os-agency-fake/acme-website-migration repo with read-only
# "Pull requests" and "Actions" permissions.
# Note: "Checks" cannot currently be granted to a fine-grained PAT at all
# (GitHub-App-only) — see docs/decisions.md. CI status is read via the
# Actions API instead.
GITHUB_TOKEN=

# Slack: a bot token (xoxb-...) from an app created directly in the
# synthetic demo workspace (never distributed/Marketplace-listed).
# Scopes needed: channels:history, channels:read, users:read
# (add groups:history/groups:read too if the demo channel is private).
SLACK_BOT_TOKEN=

# Linear: a SEPARATE personal API key, scoped to "Create issues" only
# (Settings > Account > Security & Access > Personal API keys — narrower
# than "Write", and ideally further restricted to just the team below).
# Used exclusively by the post-approval write path in apps/cli and, when
# DEMO_WRITE_MODE=enabled, apps/web (@agency-os/integration-linear-writer) —
# never by packages/agent, never by the MCP server. Must NOT be the same key as
# LINEAR_API_KEY above. apps/web doesn't need it while writes are disabled.
LINEAR_API_KEY_WRITE=

# apps/web: real Linear writes happen only with the exact value "enabled". Unset
# or anything else records an approval without executing it. The CLI ignores this.
DEMO_WRITE_MODE=disabled

# apps/web: optional limits. Anything but a positive integer refuses to start.
# MAX_CONCURRENT_INVESTIGATIONS=1
# INVESTIGATION_TIMEOUT_MS=240000

# Where traces (.traces/) and the audit log (.audit/) are written. Defaults to
# the repo root. On a host with an ephemeral disk, point this at a volume.
# AGENCY_DATA_DIR=

# Optional: makes Slack evidence link to the message, e.g. https://acme.slack.com
# SLACK_WORKSPACE_URL=

# Project registry (packages/shared/src/project-registry.ts):
# Linear project ID for the "acme-website-migration" slug.
# Find it via the Linear API/UI once the synthetic project exists.
LINEAR_PROJECT_ID_ACME=

# Linear team ID that owns the project above (IssueCreateInput.teamId is
# required and isn't derivable from the project ID alone — a project can
# span teams). Look up via the Linear API (client.project(id).teams()).
LINEAR_TEAM_ID_ACME=

# Slack channel ID (not name) for the "acme-website-migration" project's
# discussion channel. Find it via "Copy link" on the channel in Slack, or
# the channel details pane.
SLACK_CHANNEL_ID_ACME=